<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Magic Packet über UDP-Broadcast + Host-Service (TCP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- UDP-Broadcast im WLAN nötig (acquire MulticastLock) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Kurzes Vibrieren beim Long-Press-Kontextmenü -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Remote-Desktop: Sichtbarkeit der Windows App (rdp:// bzw. ms-rd:// und
         ACTION_SEND für application/rdp). startActivity würde auch ohne queries
         funktionieren; die Deklaration macht die Auflösung auf Android 11+
         explizit und stabil (resolveActivity für den Datei-Import). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rdp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ms-rd" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/rdp" />
        </intent>
        <package android:name="com.microsoft.rdc.androidx" />
    </queries>

    <application
        android:name=".WolApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WolManagerHtml"
        tools:targetApi="34">

        <activity
            android:name=".WebViewActivity"
            android:configChanges="uiMode|locale|layoutDirection|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remote-Desktop: stellt die erzeugte .rdp-Datei (Cache-Ordner rdp/) der
             Windows App als content://-URI mit befristeter Leserechte zur Verfügung. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
