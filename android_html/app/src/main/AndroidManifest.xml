<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Magic Packet über UDP-Broadcast + Host-Service (TCP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- UDP-Broadcast im WLAN nötig (acquire MulticastLock) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Kurzes Vibrieren beim Long-Press-Kontextmenü -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".WolApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WolManagerHtml"
        tools:targetApi="34">

        <activity
            android:name=".WebViewActivity"
            android:configChanges="uiMode|locale|layoutDirection|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
