{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wol-host-protocol/response-shutdown-reboot.json",
  "title": "Response to {command: shutdown|reboot} (ack before execution)",
  "allOf": [{ "$ref": "response-core.json" }],
  "properties": {
    "status": { "const": "ok" },
    "message": { "type": "string", "pattern": "^(shutdown|reboot) accepted$" }
  },
  "additionalProperties": true
}
